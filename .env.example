# Copie para .env.local e preencha. NUNCA commitar valores reais.

# Públicas (podem ir ao navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Somente servidor (nunca em código, repositório ou navegador)
SUPABASE_SERVICE_ROLE_KEY=
# Segredo Bearer da limpeza diaria Vercel; nunca usar em query string.
CRON_SECRET=
TURNSTILE_SECRET=
HMAC_SEGREDO=
LIMITE_REGISTRO_MAXIMO=
LIMITE_ACOMPANHAR_MAXIMO=
# Fotos usam orçamento independente; padrão fechado por capacidade: 8 por janela.
LIMITE_FOTO_MAXIMO=8
LIMITE_EXCLUIR_MAXIMO=
LIMITE_JANELA_SEGUNDOS=
TRIAGEM_JANELA_SEGUNDOS=
TRIAGEM_LIMITE_ORIGEM=

# Registro liberado apenas em staging fictício; opt-in servidor: staging_ficticio
AMBIENTE_REGISTRO=

# /api/registrar exige moderar_tudo; texto_automatico fica bloqueado neste marco
MODO_PUBLICACAO=

# Ambiente fechado (autenticação básica do staging; obrigatórias em produção, senão o site responde 503)
ACESSO_STAGING_USUARIO=
ACESSO_STAGING_SENHA=

# URL pública do site (opcional; base de metadados/Open Graph)
NEXT_PUBLIC_SITE_URL=

# M4: limites fixos do código: foto 2 MiB, request 2 MiB+16 KiB, até 3 slots.
# Opt-in somente no staging fictício. Ausente, falso ou inválido desliga fotos.
FOTOS_HABILITADAS=false
# Teste remoto M4: fornecer apenas no ambiente do comando; token de admin fictício com MFA AAL2.
FOTOS_STAGING_APP_URL=
FOTOS_STAGING_ADMIN_TOKEN=
# Node 24.x na Vercel; imagens-quarentena PRIVADO, file_size_limit=2097152,
# allowed_mime_types=[image/jpeg]. Aplicar migração 011 antes de habilitar fotos.
# Limpeza diária server-side: node scripts/limpar-quarentena.mjs --apply
# LIMITE_FOTO_MAXIMO é independente de LIMITE_ACOMPANHAR_MAXIMO.
